APP_NAME="Findo Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=findo_local
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=findo_local_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=findo_local_
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS=info@findogroup.com
MAIL_FROM_NAME="Findo Group"

FILESYSTEM_DISK=local

SEO_BASE_URL=https://findogroup.com
# true keeps local/staging copies out of search engines (noindex + robots.txt)
WEBSITE_PREVENT_INDEXING=true
# Node binary used to re-render CMS content (bin/render-cms.cjs)
FINDO_NODE_BIN=node
